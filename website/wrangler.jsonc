{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "frostbound-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-04",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/download/*"]
  },
  "routes": [{ "pattern": "frostbound.helsincy.com", "custom_domain": true }]
}
